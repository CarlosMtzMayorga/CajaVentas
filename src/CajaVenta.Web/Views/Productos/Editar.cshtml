@model EditarProductoModel
@{ Layout = "_Layout"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Editar producto</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">← Volver</a>
</div>

<div class="card shadow-sm col-lg-6">
    <div class="card-body">
        <form asp-action="Editar" asp-route-id="@Model.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
            </div>
            <div class="row g-3">
                <div class="col-6 mb-3">
                    <label asp-for="Costo" class="form-label"></label>
                    <input asp-for="Costo" class="form-control" type="number" step="0.01" min="0" />
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="PrecioVenta" class="form-label"></label>
                    <input asp-for="PrecioVenta" class="form-control" type="number" step="0.01" min="0" />
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="TipoImpuesto" class="form-label"></label>
                <select asp-for="TipoImpuesto" class="form-select">
                    <option value="@((int)TipoImpuesto.IVA16)">IVA 16%</option>
                    <option value="@((int)TipoImpuesto.IVA8Frontera)">IVA 8% Frontera</option>
                    <option value="@((int)TipoImpuesto.Exento)">Exento</option>
                    <option value="@((int)TipoImpuesto.IEPS)">IEPS</option>
                </select>
            </div>
            <div class="row g-3">
                <div class="col-6 mb-3">
                    <label asp-for="StockMinimo" class="form-label"></label>
                    <input asp-for="StockMinimo" class="form-control" type="number" step="0.01" min="0" />
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="UnidadMedida" class="form-label"></label>
                    <input asp-for="UnidadMedida" class="form-control" />
                </div>
            </div>
            <div class="mb-4">
                <label asp-for="Categoria" class="form-label"></label>
                <input asp-for="Categoria" class="form-control" />
            </div>
            <button class="btn btn-primary" type="submit">Guardar cambios</button>
        </form>
    </div>
</div>