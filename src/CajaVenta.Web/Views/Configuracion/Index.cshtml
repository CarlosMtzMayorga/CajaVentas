@{
    Layout = "_Layout";
    ViewData["Title"] = "Configuración";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Configuración</h1>
        <small class="text-muted">Ajustes generales del sistema</small>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6 col-xl-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-image fs-3 text-primary"></i>
                    <h2 class="h6 mb-0">Identidad visual</h2>
                </div>
                <p class="text-muted small mb-2">Logotipo, nombre comercial y datos de la empresa para tickets y constancias.</p>
                <div class="mt-auto">
                    <span class="badge text-bg-light border">Próximamente</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-printer fs-3 text-primary"></i>
                    <h2 class="h6 mb-0">Ticket e impresora</h2>
                </div>
                <p class="text-muted small mb-2">Encabezado del ticket, tamaño de papel, copias e impresora por caja.</p>
                <div class="mt-auto">
                    <span class="badge text-bg-light border">Próximamente</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-sliders fs-3 text-primary"></i>
                    <h2 class="h6 mb-0">Operación</h2>
                </div>
                <p class="text-muted small mb-2">Tipos de cambio, centavos vs. redondeo, abrir automáticamente la caja, etc.</p>
                <div class="mt-auto">
                    <span class="badge text-bg-light border">Próximamente</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-4">
        <a class="card h-100 shadow-sm text-decoration-none text-dark" asp-controller="Usuarios" asp-action="Index">
            <div class="card-body d-flex flex-column">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-person-badge fs-3 text-primary"></i>
                    <h2 class="h6 mb-0">Usuarios</h2>
                </div>
                <p class="text-muted small mb-2">Dar de alta usuarios, asignar rol (Admin/Cajero) y sucursal.</p>
                <div class="mt-auto">
                    <span class="badge text-bg-primary">Abrir</span>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-6 col-xl-4">
        <a class="card h-100 shadow-sm text-decoration-none text-dark" asp-controller="Sucursales" asp-action="Index">
            <div class="card-body d-flex flex-column">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-buildings fs-3 text-primary"></i>
                    <h2 class="h6 mb-0">Sucursales</h2>
                </div>
                <p class="text-muted small mb-2">Sucursales, cajas por punto de venta y estatus.</p>
                <div class="mt-auto">
                    <span class="badge text-bg-primary">Abrir</span>
                </div>
            </div>
        </a>
    </div>
</div>