@model CobroModel
@{
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Cobrar</h1>
        <small class="text-muted">Confirma el importe y selecciona el método de pago</small>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index" asp-controller="Pos">← Volver al POS</a>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold">Artículos del carrito</div>
            <div class="table-responsive">
                <table class="table table-sm mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Producto</th>
                            <th class="text-center">Cant.</th>
                            <th class="text-end">Precio</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Carrito)
                        {
                            <tr>
                                <td>@item.Nombre</td>
                                <td class="text-center">@item.Cantidad.ToString("N0")</td>
                                <td class="text-end">$@item.PrecioUnitario.ToString("N2")</td>
                                <td class="text-end">$@item.TotalLinea.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Subtotal</span>
                    <span>$@Model.Subtotal.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Impuestos</span>
                    <span>$@Model.Impuestos.ToString("N2")</span>
                </div>
                <hr />
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="fw-bold">Total a pagar</span>
                    <span class="total-amount large">$@Model.Total.ToString("N2")</span>
                </div>

                <form asp-action="ConfirmarCobro" asp-controller="Pos" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label" for="ClienteId">Cliente</label>
                        <select id="ClienteId" name="ClienteId" class="form-select">
                            <option value="">Cliente mostrador</option>
                            @foreach (var c in Model.Clientes)
                            {
                                <option value="@c.Id" selected="@(Model.ClienteId == c.Id)">@c.NombreRazonSocial (@c.RFC)</option>
                            }
                        </select>
                        <div class="form-text">Por defecto "Cliente mostrador". Selecciona uno si le facturarás.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Método de pago</label>
                        @foreach (var metodo in MetodosPagoUI.Lista)
                        {
                            <div class="form-check">
                                <input class="form-check-input metodo-pago" type="radio" name="MetodoPago"
                                       value="@((int)metodo.Valor)" id="metodo_@((int)metodo.Valor)"
                                       @(metodo.Valor == MetodoPago.Efectivo ? "checked" : "")
                                       onchange="actualizarMontoRecibido()" />
                                <label class="form-check-label" for="metodo_@((int)metodo.Valor)">@metodo.Texto</label>
                            </div>
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="MontoRecibido">Monto recibido</label>
                        <input type="text" id="MontoRecibido" name="MontoRecibido" class="form-control form-control-lg"
                               value="@Model.MontoRecibido" inputmode="decimal" />
                    </div>
                    <button class="btn btn-success btn-lg w-100" type="submit">Confirmar pago</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    var total = @Model.Total.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
    function actualizarMontoRecibido() {
        var efectivo = document.getElementById('metodo_@((int)MetodoPago.Efectivo)').checked;
        var input = document.getElementById('MontoRecibido');
        if (efectivo) input.value = total.toFixed(2);
    }
</script>