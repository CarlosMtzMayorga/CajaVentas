@model CajaVenta.Portal.Models.SuscriptorViewModel
@{
    ViewData["Title"] = "Editar cliente";
}

<h1 class="page-title h3 mb-4">Editar cliente</h1>

<form asp-action="Editar" method="post" class="card shadow-sm">
    <input type="hidden" asp-for="Id" />
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Nombre comercial *</label>
                <input asp-for="NombreComercial" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">Razón social</label>
                <input asp-for="RazonSocial" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">RFC</label>
                <input asp-for="Rfc" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Email</label>
                <input asp-for="Email" class="form-control" type="email" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Teléfono</label>
                <input asp-for="Telefono" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">URL de acceso (identificador) *</label>
                <div class="input-group">
                    <span class="input-group-text">https://app.cajaventa.mx/</span>
                    <input asp-for="UrlAcceso" class="form-control" required />
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label">Estado</label>
                <select asp-for="Estado.Valor" class="form-select">
                    @foreach (var opcion in Model.Estado.Opciones)
                    {
                        <option value="@opcion">@opcion</option>
                    }
                </select>
            </div>
        </div>
    </div>
    <div class="card-footer d-flex justify-content-end gap-2">
        <a asp-action="Detalle" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
        <button class="btn btn-primary"><i class="bi bi-check-lg"></i> Guardar</button>
    </div>
</form>