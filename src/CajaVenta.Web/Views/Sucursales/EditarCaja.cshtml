@model EditarCajaModel
@{ Layout = "_Layout"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Editar caja</h1>
        <small class="text-muted">@Model.Nombre</small>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Cajas" asp-route-sucursalId="@Model.SucursalId">← Volver</a>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="EditarCaja" asp-route-cajaId="@Model.Id" method="post">
                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label"></label>
                        <input asp-for="Nombre" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Notas" class="form-label"></label>
                        <textarea asp-for="Notas" class="form-control" rows="2"></textarea>
                    </div>
                    <button class="btn btn-primary" type="submit">Guardar cambios</button>
                </form>
            </div>
        </div>
    </div>
</div>