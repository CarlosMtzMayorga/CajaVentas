@model List<CajaVenta.Portal.Entities.Suscriptor>
@using CajaVenta.Portal.Enums
@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="page-title h3 mb-0">Clientes suscriptores</h1>
    <a asp-action="Crear" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nuevo cliente</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Nombre comercial</th>
                    <th>URL de acceso</th>
                    <th>RFC</th>
                    <th>Contacto</th>
                    <th>Estado</th>
                    <th>Alta</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="fw-semibold">@s.NombreComercial</td>
                        <td><code>@s.UrlAcceso</code></td>
                        <td>@s.Rfc</td>
                        <td>
                            <div>@s.Email</div>
                            <small class="text-muted">@s.Telefono</small>
                        </td>
                        <td>
                            <span class="badge @(s.Estado switch {
                                EstadoSuscriptor.Activo => "text-bg-success",
                                EstadoSuscriptor.Prueba => "text-bg-info",
                                EstadoSuscriptor.Suspendido => "text-bg-warning",
                                _ => "text-bg-secondary"
                            })">@s.Estado</span>
                        </td>
                        <td>@s.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td class="text-end">
                            <a asp-action="Detalle" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Ver</a>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-muted text-center py-4">No hay clientes registrados.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>