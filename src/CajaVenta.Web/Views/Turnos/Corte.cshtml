@model CorteXDto
@{ Layout = "_Layout"; }

<div class="no-print d-flex justify-content-between align-items-center mb-3">
    <a class="btn btn-outline-secondary" asp-action="Index" asp-controller="Turnos">← Volver a turnos</a>
    <button class="btn btn-primary" onclick="window.print()">Imprimir corte</button>
</div>

<div class="ticket-wrap">
    <div class="ticket p-4">
        <div class="text-center mb-3">
            <div class="fw-bold fs-5">CAJAVENTA</div>
            <small>CORTE DE CAJA (X)</small><br />
            <small>@Model.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
        </div>

        <div class="d-flex justify-content-between">
            <span>Ventas (efectivo)</span>
            <span>$@Model.VentasEfectivo.ToString("N2")</span>
        </div>
        <div class="d-flex justify-content-between">
            <span>Ventas (tarjeta/otros)</span>
            <span>$@Model.VentasTarjeta.ToString("N2")</span>
        </div>
        <div class="d-flex justify-content-between fw-bold">
            <span>TOTAL VENTAS</span>
            <span>$@Model.TotalVentas.ToString("N2")</span>
        </div>
        <div class="d-flex justify-content-between">
            <span>Tickets</span>
            <span>@Model.CantidadVentas</span>
        </div>

        <hr />
        <div class="d-flex justify-content-between">
            <span>Fondo inicial</span>
            <span>$@Model.FondoInicial.ToString("N2")</span>
        </div>
        <div class="d-flex justify-content-between fw-bold fs-5 mt-2">
            <span>EFECTIVO EN CAJA</span>
            <span>$@Model.EnCaja.ToString("N2")</span>
        </div>

        <div class="text-center mt-4 small">CajaVenta</div>
    </div>
</div>