@model ClientesIndexModel
@{ Layout = "_Layout"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Clientes</h1>
        <small class="text-muted">Registro con RFC y constancia de situación fiscal para facturar</small>
    </div>
    <a class="btn btn-primary" asp-action="Crear">+ Nuevo cliente</a>
</div>

@if (Model.Mensaje is not null)
{
    <div class="alert alert-success alert-dismissible">@Model.Mensaje<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (Model.Error is not null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-auto" style="flex:1">
                <input type="text" name="q" class="form-control" value="@Model.Busqueda" placeholder="Buscar por razón social, RFC, comercio o correo" />
            </div>
            <div class="col-auto">
                <button class="btn btn-outline-primary" type="submit">Buscar</button>
                <a class="btn btn-link" asp-action="Index">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white fw-semibold">
        @Model.Clientes.Count cliente(s)
    </div>
    <div class="table-responsive">
        <table class="table table-sm table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Cliente</th>
                    <th>RFC</th>
                    <th>Contacto</th>
                    <th class="text-center">CFDI</th>
                    <th class="text-center">Constancia</th>
                    <th class="text-center">Estatus</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Clientes.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No hay clientes registrados</td></tr>
                }
                @foreach (var c in Model.Clientes)
                {
                    <tr class="@(c.Activo ? "" : "table-secondary")">
                        <td>
                            <span class="fw-semibold">@c.NombreRazonSocial</span>
                            @if (!string.IsNullOrEmpty(c.NombreComercial))
                            {
                                <div class="small text-muted">@c.NombreComercial</div>
                            }
                        </td>
                        <td class="text-uppercase small">@c.RFC</td>
                        <td>
                            <div class="small">@c.Email</div>
                            <div class="small text-muted">@c.Telefono</div>
                        </td>
                        <td class="small">
                            @if (!string.IsNullOrEmpty(c.UsoCFDI))
                            {
                                <div>@c.UsoCFDI</div>
                            }
                            @if (!string.IsNullOrEmpty(c.RegimenFiscal))
                            {
                                <div class="text-muted small">Régimen @c.RegimenFiscal</div>
                            }
                        </td>
                        <td class="text-center">
                            @if (c.TieneConstancia)
                            {
                                <span class="badge text-bg-success">Subida</span>
                                <a class="btn btn-sm btn-link p-0 ms-1" asp-action="DescargarConstancia" asp-route-id="@c.Id" title="@c.ConstanciaOriginalNombre">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                                </a>
                            }
                            else
                            {
                                <span class="badge text-bg-danger">Falta</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (c.Activo)
                            {
                                <span class="badge text-bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@c.Id">Editar</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <form method="post" asp-action="AlternarActivo" asp-route-id="@c.Id" asp-route-activo="@(!c.Activo)" class="d-inline">
                                    <button type="submit" class="btn btn-sm @(c.Activo ? "btn-outline-danger" : "btn-outline-success")">
                                        @(c.Activo ? "Desactivar" : "Activar")
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>