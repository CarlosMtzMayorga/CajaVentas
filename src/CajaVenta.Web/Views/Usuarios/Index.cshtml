@model UsuariosIndexModel
@{ Layout = "_Layout"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Usuarios</h1>
        <small class="text-muted">Usuarios del sistema y sucursal asignada</small>
    </div>
    <a class="btn btn-primary" asp-action="Crear">+ Nuevo usuario</a>
</div>

@if (Model.Mensaje is not null)
{
    <div class="alert alert-success alert-dismissible">@Model.Mensaje<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (Model.Error is not null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

<div class="card shadow-sm">
    <div class="card-header bg-white fw-semibold">
        @Model.Usuarios.Count usuario(s)
    </div>
    <div class="table-responsive">
        <table class="table table-sm table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Usuario</th>
                    <th>Nombre de usuario</th>
                    <th>Sucursal</th>
                    <th class="text-center">Rol</th>
                    <th class="text-center">Estatus</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Usuarios.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No hay usuarios registrados</td></tr>
                }
                @foreach (var u in Model.Usuarios)
                {
                    <tr class="@(u.Activo ? "" : "table-secondary")">
                        <td>
                            <span class="fw-semibold">@u.Nombre</span>
                            <div class="small text-muted">@u.Email</div>
                        </td>
                        <td>@u.NombreUsuario</td>
                        <td>
                            @if (string.IsNullOrEmpty(u.SucursalNombre))
                            {
                                <span class="badge text-bg-light border">Global</span>
                            }
                            else
                            {
                                @u.SucursalNombre
                            }
                        </td>
                        <td class="text-center">
                            <span class="badge @(u.Rol == "Admin" ? "text-bg-dark" : "text-bg-primary")">@u.Rol</span>
                        </td>
                        <td class="text-center">
                            @if (u.Activo)
                            {
                                <span class="badge text-bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@u.Id">Editar</a>
                            <button class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#resetPwd-@u.Id">Contraseña</button>
                            <form method="post" asp-action="AlternarActivo" asp-route-id="@u.Id" asp-route-activo="@(!u.Activo)" class="d-inline">
                                <button type="submit" class="btn btn-sm @(u.Activo ? "btn-outline-danger" : "btn-outline-success")">
                                    @(u.Activo ? "Desactivar" : "Activar")
                                </button>
                            </form>
                        </td>
                    </tr>
                    <div class="modal fade" id="resetPwd-@u.Id" tabindex="-1">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <form method="post" asp-action="ReiniciarContrasena" asp-route-id="@u.Id">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Restablecer contraseña — @u.NombreUsuario</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <label class="form-label">Nueva contraseña (mínimo 6 caracteres)</label>
                                        <input type="password" name="contrasena" class="form-control" required minlength="6" />
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                        <button class="btn btn-primary" type="submit">Guardar</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </tbody>
        </table>
    </div>
</div>