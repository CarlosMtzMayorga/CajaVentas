@{
    Layout = null;
    var mensaje = (string?)ViewData["MensajeError"] ?? "Ocurrió un error inesperado";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CajaVenta — Error</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-body">
    <div class="login-card text-center">
        <h1 class="display-5 fw-bold text-danger mb-3">Error</h1>
        <p class="text-muted">@mensaje</p>
        <a class="btn btn-primary" asp-controller="Auth" asp-action="Login">Volver a iniciar sesión</a>
    </div>
</body>
</html>