@model CajaVenta.Portal.Models.SuscripcionViewModel
@using CajaVenta.Portal.Enums
@{
    ViewData["Title"] = "Editar suscripción";
}

<h1 class="page-title h3 mb-4">Editar suscripción</h1>

<form asp-action="Editar" method="post" class="card shadow-sm">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="SuscriptorId" />
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Plan</label>
                <select asp-for="PlanId" class="form-select">
                    @foreach (var p in Model.Planes)
                    {
                        <option value="@p.Id">@p.Nombre — $@p.PrecioMensual.ToString("N2")/mes</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Precio mensual</label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="PrecioMensual" class="form-control" type="number" step="0.01" min="0" />
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label">Estado</label>
                <select asp-for="Estado" class="form-select">
                    <option value="@EstadoSuscripcion.Activa">Activa</option>
                    <option value="@EstadoSuscripcion.Pendiente">Pendiente</option>
                    <option value="@EstadoSuscripcion.Vencida">Vencida</option>
                    <option value="@EstadoSuscripcion.Cancelada">Cancelada</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Fecha inicio</label>
                <input asp-for="FechaInicio" class="form-control" type="date" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Fecha vencimiento</label>
                <input asp-for="FechaVencimiento" class="form-control" type="date" />
            </div>
        </div>
    </div>
    <div class="card-footer d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        <button class="btn btn-primary"><i class="bi bi-check-lg"></i> Guardar</button>
    </div>
</form>