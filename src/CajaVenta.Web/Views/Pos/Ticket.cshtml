@model VentaDto
@{
    Layout = "_Layout";
}

@if (ViewData["MensajeExito"] is string exito)
{
    <div class="alert alert-success d-flex justify-content-between align-items-center">
        <span><i class="bi bi-check-circle"></i> @exito</span>
        <a class="btn btn-sm btn-success ms-3" asp-action="Index" asp-controller="Pos">Nueva venta</a>
    </div>
}

<div class="no-print d-flex justify-content-between align-items-center mb-3">
    <a class="btn btn-outline-secondary" asp-action="Index" asp-controller="Pos">← Nueva venta</a>
    <button class="btn btn-primary" onclick="window.print()">
        <i class="bi bi-printer"></i> Imprimir ticket
    </button>
</div>

<div class="ticket-wrap">
    <div class="ticket p-4">
        <div class="text-center mb-3">
            <div class="fw-bold fs-5">CAJAVENTA</div>
            <small>Ticket: <strong>@Model.NumeroTicket</strong></small><br />
            <small>@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</small>
        </div>

        @if (!string.IsNullOrEmpty(Model.ClienteNombre))
        {
            <div class="mb-2 small">
                <div class="fw-semibold">@Model.ClienteNombre.ToUpper()</div>
                @if (!string.IsNullOrEmpty(Model.ClienteRfc))
                {
                    <div>RFC: @Model.ClienteRfc</div>
                }
            </div>
        }
        else
        {
            <div class="mb-2 small text-muted">CLIENTE MOSTRADOR</div>
        }

        <table class="table table-sm mb-2 align-middle">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th class="text-center">Cant.</th>
                    <th class="text-end">Precio</th>
                    <th class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var detalle in Model.Detalles)
                {
                    <tr>
                        <td>@detalle.ProductoNombre</td>
                        <td class="text-center">@detalle.Cantidad.ToString("N0")</td>
                        <td class="text-end">$@detalle.PrecioUnitario.ToString("N2")</td>
                        <td class="text-end">$@detalle.Total.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>

        <hr />
        <div class="d-flex justify-content-between">
            <span>Subtotal</span>
            <span>$@Model.Subtotal.ToString("N2")</span>
        </div>
        <div class="d-flex justify-content-between">
            <span>Impuestos</span>
            <span>$@Model.Impuestos.ToString("N2")</span>
        </div>
        <div class="d-flex justify-content-between fw-bold fs-5 mt-2">
            <span>TOTAL</span>
            <span>$@Model.Total.ToString("N2")</span>
        </div>

        <hr />
        <div class="d-flex justify-content-between">
            <span>Método de pago</span>
            <span>@Model.MetodoPago.ToString()</span>
        </div>
        @if (Model.MetodoPago == MetodoPago.Efectivo)
        {
            <div class="d-flex justify-content-between">
                <span>Recibido</span>
                <span>$@Model.MontoRecibido.ToString("N2")</span>
            </div>
            <div class="d-flex justify-content-between">
                <span>Cambio</span>
                <span>$@Model.Cambio.ToString("N2")</span>
            </div>
        }

        <div class="text-center mt-4 small">
            ¡Gracias por su compra!<br />
            CajaVenta
        </div>
    </div>
</div>