@model CajaVenta.Portal.Models.SuscripcionViewModel
@using CajaVenta.Portal.Enums
@{
    ViewData["Title"] = "Nueva suscripción";
}

<h1 class="page-title h3 mb-4">Nueva suscripción</h1>

<form asp-action="Crear" method="post" class="card shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Cliente *</label>
                <select asp-for="SuscriptorId" class="form-select" required>
                    <option value="">— Selecciona —</option>
                    @foreach (var s in Model.Suscriptores)
                    {
                        <option value="@s.Id">@s.NombreComercial (@s.UrlAcceso)</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Plan *</label>
                <select asp-for="PlanId" class="form-select" required>
                    <option value="">— Selecciona —</option>
                    @foreach (var p in Model.Planes)
                    {
                        <option value="@p.Id">@p.Nombre — $@p.PrecioMensual.ToString("N2")/mes</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Fecha de inicio</label>
                <input asp-for="FechaInicio" class="form-control" type="date" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Meses (1-36)</label>
                <input asp-for="Meses" class="form-control" type="number" min="1" max="36" value="1" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Estado inicial</label>
                <select asp-for="Estado" class="form-select">
                    <option value="@EstadoSuscripcion.Activa">Activa</option>
                    <option value="@EstadoSuscripcion.Pendiente">Pendiente</option>
                    <option value="@EstadoSuscripcion.Vencida">Vencida</option>
                </select>
            </div>
        </div>
    </div>
    <div class="card-footer d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        <button class="btn btn-primary"><i class="bi bi-check-lg"></i> Crear</button>
    </div>
</form>