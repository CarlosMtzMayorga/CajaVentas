@model SucursalesIndexModel
@{ Layout = "_Layout"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Sucursales</h1>
        <small class="text-muted">Catálogo de sucursales con cajas por punto de venta</small>
    </div>
    <a class="btn btn-primary" asp-action="Crear">+ Nueva sucursal</a>
</div>

@if (Model.Mensaje is not null)
{
    <div class="alert alert-success alert-dismissible">@Model.Mensaje<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (Model.Error is not null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

<div class="card shadow-sm">
    <div class="card-header bg-white fw-semibold">
        @Model.Sucursales.Count sucursal(es)
    </div>
    <div class="table-responsive">
        <table class="table table-sm table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Sucursal</th>
                    <th>Contacto</th>
                    <th class="text-center">Cajas</th>
                    <th class="text-center">Usuarios</th>
                    <th class="text-center">Estatus</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Sucursales.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No hay sucursales registradas</td></tr>
                }
                @foreach (var s in Model.Sucursales)
                {
                    <tr class="@(s.Activo ? "" : "table-secondary")">
                        <td>
                            <span class="fw-semibold">@s.Nombre</span>
                            @if (!string.IsNullOrEmpty(s.Direccion))
                            {
                                <div class="small text-muted">@s.Direccion</div>
                            }
                        </td>
                        <td class="small">
                            <div>@s.Telefono</div>
                        </td>
                        <td class="text-center">
                            <a asp-action="Cajas" asp-route-sucursalId="@s.Id" class="fw-semibold">@s.CantidadCajas</a>
                        </td>
                        <td class="text-center">@s.CantidadUsuarios</td>
                        <td class="text-center">
                            @if (s.Activo)
                            {
                                <span class="badge text-bg-success">Activa</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Inactiva</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Cajas" asp-route-sucursalId="@s.Id">Cajas</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@s.Id">Editar</a>
                            <form method="post" asp-action="AlternarActivo" asp-route-id="@s.Id" asp-route-activo="@(!s.Activo)" class="d-inline">
                                <button type="submit" class="btn btn-sm @(s.Activo ? "btn-outline-danger" : "btn-outline-success")">
                                    @(s.Activo ? "Desactivar" : "Activar")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>